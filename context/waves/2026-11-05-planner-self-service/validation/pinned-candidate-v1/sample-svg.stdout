<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 640" role="img" aria-labelledby="terrain-title terrain-desc"><title id="terrain-title">TERRAIN territory split</title><desc id="terrain-desc">Data-bound territory split with site, demand, revenue, assignee, and centroid metadata for dashboard embedding.</desc><rect width="100%" height="100%" fill="#f8fafc"/><g transform="translate(28 64)"><text x="0" y="-28" font-family="Inter,Segoe UI,sans-serif" font-size="28" font-weight="700" fill="#0f172a">TERRAIN split preview</text><text x="0" y="-6" font-family="Inter,Segoe UI,sans-serif" font-size="13" fill="#475569">Site assignments and territory centroids.</text><g class="territory" data-territory-id="north" data-site-count="3" data-demand="31.00" data-revenue="290000.00" data-assignee-count="3" data-assignees="Avery;Morgan;Sam"><circle class="site" data-site-id="N-001" data-territory-id="north" data-demand="12.00" data-revenue="120000.00" cx="287.3" cy="166.5" r="9" fill="#2563eb" fill-opacity="0.82" stroke="#ffffff" stroke-width="2"/><circle class="site" data-site-id="N-002" data-territory-id="north" data-demand="10.00" data-revenue="90000.00" cx="595.6" cy="56.0" r="9" fill="#2563eb" fill-opacity="0.82" stroke="#ffffff" stroke-width="2"/><circle class="site" data-site-id="N-003" data-territory-id="north" data-demand="9.00" data-revenue="80000.00" cx="749.8" cy="254.9" r="9" fill="#2563eb" fill-opacity="0.82" stroke="#ffffff" stroke-width="2"/><rect x="558.2" y="127.1" width="188" height="64" rx="12" fill="#ffffff" stroke="#2563eb" stroke-width="2"/><text x="572.2" y="151.1" font-family="Inter,Segoe UI,sans-serif" font-size="14" font-weight="700" fill="#0f172a">North field team</text><text x="572.2" y="171.1" font-family="Inter,Segoe UI,sans-serif" font-size="12" fill="#334155">3 sites - 3 people - $290k</text><text x="572.2" y="189.1" font-family="Inter,Segoe UI,sans-serif" font-size="11" fill="#64748b">Avery, Morgan, Sam</text></g><g class="territory" data-territory-id="south" data-site-count="3" data-demand="31.00" data-revenue="292000.00" data-assignee-count="2" data-assignees="Jordan;Riley"><circle class="site" data-site-id="S-001" data-territory-id="south" data-demand="11.00" data-revenue="105000.00" cx="904.0" cy="431.6" r="9" fill="#16a34a" fill-opacity="0.82" stroke="#ffffff" stroke-width="2"/><circle class="site" data-site-id="S-002" data-territory-id="south" data-demand="10.00" data-revenue="95000.00" cx="441.5" cy="520.0" r="9" fill="#16a34a" fill-opacity="0.82" stroke="#ffffff" stroke-width="2"/><circle class="site" data-site-id="S-003" data-territory-id="south" data-demand="10.00" data-revenue="92000.00" cx="56.0" cy="365.3" r="9" fill="#16a34a" fill-opacity="0.82" stroke="#ffffff" stroke-width="2"/><rect x="481.2" y="407.0" width="188" height="64" rx="12" fill="#ffffff" stroke="#16a34a" stroke-width="2"/><text x="495.2" y="431.0" font-family="Inter,Segoe UI,sans-serif" font-size="14" font-weight="700" fill="#0f172a">South field team</text><text x="495.2" y="451.0" font-family="Inter,Segoe UI,sans-serif" font-size="12" fill="#334155">3 sites - 2 people - $292k</text><text x="495.2" y="469.0" font-family="Inter,Segoe UI,sans-serif" font-size="11" fill="#64748b">Jordan, Riley</text></g></g></svg>
